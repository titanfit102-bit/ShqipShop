# SHQIPSHOP_FX_ALL_PER_EUR=<trusted numeric ALL per 1 EUR>
# SHQIPSHOP_FX_AS_OF=YYYY-MM-DD
# SHQIPSHOP_FX_SOURCE=<accurate source name>
